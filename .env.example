# ==============================================================================
# AIRGUARD AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure local or production variables.
# NEVER commit the active .env file to source control.
# ==============================================================================

# Core Application Settings
PROJECT_NAME="AirGuard AI"
VERSION="1.3.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"       # Set to 'production' for live deployments
DEBUG=true

# Database Connection (SQLite default for development; PostgreSQL for production)
DATABASE_URL="sqlite:///./airguard.db"
# DATABASE_URL="postgresql://airguard:password@localhost:5432/airguard_db"

# Data Quality & Freshness Thresholds
DATA_STALE_THRESHOLD_MINUTES=120

# ------------------------------------------------------------------------------
# Provider API Credentials (Optional: adapters operate in mock/unauthenticated mode if unset)
# ------------------------------------------------------------------------------
# 1. OpenAQ API v3 (https://docs.openaq.org/)
OPENAQ_API_KEY=""
OPENAQ_BASE_URL="https://api.openaq.org/v3"

# 2. Open-Meteo Air Quality (Free model grids; no key required)
OPEN_METEO_AIR_BASE_URL="https://air-quality-api.open-meteo.com/v1"
OPEN_METEO_WEATHER_BASE_URL="https://api.open-meteo.com/v1"

# 3. CPCB / data.gov.in (Requires key from https://data.gov.in/)
DATAGOVIN_API_KEY=""
DATAGOVIN_BASE_URL="https://api.data.gov.in/resource"
DATAGOVIN_RESOURCE_ID="3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69"

# ------------------------------------------------------------------------------
# LLM Explainer Credentials (Backend-only; strictly excluded from alert decision path)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# ------------------------------------------------------------------------------
# Firebase Cloud Messaging (FCM) Credentials (Backend-only; never include in mobile app)
# ------------------------------------------------------------------------------
FIREBASE_CREDENTIALS_PATH=""   # e.g., /secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=""         # e.g., airguard-ai-prod

# ------------------------------------------------------------------------------
# Authentication & Cryptographic Security
# ------------------------------------------------------------------------------
# MUST be overridden in production with a cryptographically secure 256-bit random string
JWT_SECRET_KEY="airguard-ai-development-jwt-secret-key-2026"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Alert Engine Tuning
ALERT_DEFAULT_AQI_THRESHOLD=200
ALERT_DEFAULT_PM25_THRESHOLD=60.0
ALERT_DEFAULT_PM10_THRESHOLD=100.0
ALERT_COOLDOWN_MINUTES=180
ALERT_ESCALATION_DELTA_AQI=50
ALERT_SPIKE_DELTA_AQI=40
ALERT_SPIKE_RATIO_PM25=0.50
ALERT_STALE_DATA_HOURS=6.0
